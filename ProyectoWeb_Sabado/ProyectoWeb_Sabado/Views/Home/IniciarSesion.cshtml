@model ProyectoWeb_Sabado.Entities.Usuario

@{
    ViewData["Title"] = "IniciarSesion";
    Layout = "~/Views/Shared/_Layout - Externo.cshtml";
}

<div class="hold-transition login-page">
    <div class="login-box">
        <div class="card">
            <div class="card-body login-card-body">
                <p class="login-box-msg">Inicie sesión con su cuenta</p>
                @using (Html.BeginForm("IniciarSesion", "Home", FormMethod.Post))
                {
                    <div class="input-group mb-3">
                        @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", @placeholder = "Correo Electrónico", @required = "true" })
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-envelope"></span>
                            </div>
                        </div>
                    </div>
                    <div class="input-group mb-3">
                        @Html.TextBoxFor(m => m.Contrasenna, new { @class = "form-control", @placeholder = "Contraseña", @type = "Password", @required = "true" })
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-lock"></span>
                            </div>
                        </div>
                    </div>
                    @if (ViewBag.MsjPantalla != null)
                    {
                        <div class="alert alert-warning" role="alert" style="text-align:center">
                            @ViewBag.MsjPantalla
                        </div>
                    }
                    <div>
                        <div >
                            <button type="submit" class="btn btn-primary btn-block">Iniciar Sesión</button>
                        </div>
                    </div>
                }
                <br />
                <div style="text-align:center; margin-top: 2%">
                    <a href="@Url.Action("RecuperarAcceso","Home")" class="text-center">¿Olvidaste la contraseña?</a>
                </div>
                <div style="text-align:center; margin-top: 2%">
                    <a href="@Url.Action("RegistrarUsuario","Home")" class="text-center">¿Aún no tienes una cuenta?</a>
                </div>
            </div>
        </div>
    </div>
</div>